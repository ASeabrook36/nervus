#!/opt/nervus/.venv/bin/python
"""set-token -- replace one token's value in nervus's token file.

Run on the nervus machine (inside its container, if it has one), as root, with
nervus's own venv, with the new value piped in from wherever it is kept:

    <print the new value> | /opt/nervus/.venv/bin/python set-token <id>

The new value arrives on stdin (or, typed at a terminal, at a hidden prompt),
so it never appears in a command line, an editor or the screen. Nothing it
prints contains a token value.

It makes the edit a person would make by hand, with the checks built in: only the one value changes, byte for byte;
the result is loaded with nervus's own load_tokens before it replaces the
original; and ownership and mode 0600 are kept. The swap is atomic, so a
failure at any point leaves the original untouched. nervus reads the file only
at startup, so it still needs `systemctl restart nervus` afterwards.
"""

from __future__ import annotations

import getpass
import os
import re
import stat
import sys
import tempfile
from pathlib import Path

from nervus.auth import load_tokens

TOKENS = Path(os.environ.get("NERVUS_TOKENS_FILE", "/opt/nervus/secrets/tokens.yaml"))
SHAPE = re.compile(r"[A-Za-z0-9_-]{32,}")


def read_plain(path: Path) -> str:
    """The text of the file at `path`, opened without waiting and read only if it is a file.
    nervus's own account owns the folder, and can put a pipe where the file was: a plain read
    of a pipe waits for a writer that never comes, and whatever ran this waits with it. As
    nervus.plainfile.read_text, which this cannot use: a deploy runs this
    from the tree it is about to install, with the nervus still installed, which may have none."""
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOCTTY)
    try:
        mode = os.fstat(fd).st_mode
        if not stat.S_ISREG(mode):
            what = "pipe" if stat.S_ISFIFO(mode) else "folder" if stat.S_ISDIR(mode) else "device"
            raise OSError(f"it is a {what}, not a file")
    except BaseException:
        os.close(fd)
        raise
    with os.fdopen(fd) as f:
        return f.read()


def fail(msg: str) -> None:
    print(f"set-token: {msg}", file=sys.stderr)
    sys.exit(1)


def read_new_value() -> str:
    if sys.stdin.isatty():
        value = getpass.getpass("new token value (hidden): ")
    else:
        value = sys.stdin.readline()
    value = value.strip()
    if not value:
        fail("no value was read; nothing changed")
    if not SHAPE.fullmatch(value):
        fail("the value is not a URL-safe token of 32+ characters; nothing changed")
    return value


def main() -> None:
    if len(sys.argv) != 2:
        fail("usage: set-token <token-id>")
    token_id = sys.argv[1]

    old = load_tokens(TOKENS)
    matches = [s for s, t in old.items() if t.id == token_id]
    if len(matches) != 1:
        fail(f"expected one entry with id {token_id!r}, found {len(matches)}; nothing changed")
    old_value = matches[0]

    new_value = read_new_value()
    if new_value == old_value:
        fail(f"the new value is the same as the current one for {token_id!r}; nothing changed")
    if new_value in old:
        fail(f"the new value is already used by {old[new_value].id!r}; nothing changed")

    try:
        text = read_plain(TOKENS)
    except OSError as exc:
        fail(f"cannot read {TOKENS}: {exc}; nothing changed")
    if text.count(old_value) != 1:
        fail("the current value does not appear exactly once in the file; nothing changed")
    new_text = text.replace(old_value, new_value)

    st = TOKENS.stat()
    fd, tmp = tempfile.mkstemp(dir=TOKENS.parent, prefix=".tokens.", suffix=".tmp")
    try:
        os.fchmod(fd, 0o600)
        if os.geteuid() == 0:
            os.fchown(fd, st.st_uid, st.st_gid)
        with os.fdopen(fd, "w") as f:
            f.write(new_text)
            f.flush()
            os.fsync(f.fileno())

        # Check the candidate with the loader nervus itself uses.
        new = load_tokens(Path(tmp))
        by_id_old = {t.id: (s, t) for s, t in old.items()}
        by_id_new = {t.id: (s, t) for s, t in new.items()}
        if by_id_old.keys() != by_id_new.keys():
            fail("the set of token ids would change; nothing changed")
        for i in sorted(by_id_new):
            (os_, ot), (ns, nt) = by_id_old[i], by_id_new[i]
            if ot != nt:
                fail(f"{i!r} would change more than its value; nothing changed")
            if (i == token_id) != (os_ != ns):
                fail(f"{i!r} would change unexpectedly; nothing changed")

        os.replace(tmp, TOKENS)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise

    final = load_tokens(TOKENS)
    after = TOKENS.stat()
    print(f"  {TOKENS}: mode {after.st_mode & 0o777:o}, owner uid {after.st_uid}")
    for s, t in sorted(final.items(), key=lambda kv: kv[1].id):
        status = "token changed" if t.id == token_id else "unchanged"
        print(f"  {t.id:32} {status}")
    print("  nervus still has the old value until: systemctl restart nervus")


if __name__ == "__main__":
    main()
