#!/usr/bin/env python3
"""release-name -- the name of a release's folder: its number and its code (ADR-0029 question 3a).

Run by install.sh with the machine's own Python, before any venv exists, so it needs nothing
beyond Python's standard library:

    python3 -I tools/release-name [--full] <folder>
    git archive HEAD | python3 -I tools/release-name [--full] --archive

It prints the name of the folder under /opt/nervus/releases/ that the tree is installed in,
<number>-<the first 12 hex digits of its code>, such as 0.2.0-42c0b5a132ef. --full prints that
name, the number and the whole code, on one line, separated by spaces. --archive reads the tree
from a tar stream on standard input (git archive's, compressed or not) instead of a folder, read
to the archive's end: a stream cut short, or a header that cannot be read, is refused.

The number is pyproject.toml's [project] version: three numbers with no leading zeros, such as
0.2.0, as tests/test_package.py requires. Any other is refused.

The code is one SHA-256 over what the release folder holds, worked out the same way from a
clone's `git archive` and from a folder, so a clone, an archive of the same commit unpacked, and
that release's folder all give one code. For each regular file and symbolic link, sorted by the
bytes of its path: its kind (f, a file; x, a file its owner may run; l, a link), the SHA-256 of
its bytes (a link's: of its target), and its path from the tree's top, each ended by a NUL.
Folders are not counted, nor any of a file's mode but its owner's run bit, which git records and
tar and unzip keep; bytes are taken as they are. Left out:

- at the top, .git, a clone's history, which an archive has not; .venv, a venv, which is built
  after the name is known; secrets, transfer, hosts.yaml and releases, which an installation
  keeps beside its code (the tree's own hosts.yaml is not copied into a release's folder); and
  .release, the name kept for a record a later release may write in its folder;
- at any depth, __pycache__, the bytecode Python writes as it runs.

Exit 0: the name printed. Exit 1: refused, the number or the tree, saying why on standard error,
with nothing on standard output. Exit 2: it could not run (its arguments).
"""

from __future__ import annotations

import argparse
import hashlib
import os
import re
import stat
import sys
import tarfile
import tomllib

LEFT_OUT_AT_THE_TOP = {b".git", b".venv", b"secrets", b"transfer", b"releases", b"hosts.yaml", b".release"}
NUMBER = re.compile(r"(0|[1-9][0-9]*)(\.(0|[1-9][0-9]*)){2}")


class Refused(Exception):
    """Not a tree this can name; the message says why."""


def left_out(path: bytes) -> bool:
    parts = path.split(b"/")
    return parts[0] in LEFT_OUT_AT_THE_TOP or b"__pycache__" in parts


class Tree:
    """What the code counts, path by path, and pyproject.toml's bytes, from a folder or an archive."""

    def __init__(self):
        self.counted: dict[bytes, tuple[bytes, bytes]] = {}
        self.pyproject: bytes | None = None

    def file(self, path: bytes, mode: int, data: bytes) -> None:
        kind = b"x" if mode & stat.S_IXUSR else b"f"
        self.counted[path] = (kind, hashlib.sha256(data).hexdigest().encode())
        if path == b"pyproject.toml":
            self.pyproject = data

    def link(self, path: bytes, target: bytes) -> None:
        self.counted[path] = (b"l", hashlib.sha256(target).hexdigest().encode())

    def code(self) -> str:
        whole = hashlib.sha256()
        for path in sorted(self.counted):
            kind, digest = self.counted[path]
            whole.update(kind + b"\0" + digest + b"\0" + path + b"\0")
        return whole.hexdigest()


def from_folder(top: str) -> Tree:
    if not os.path.isdir(top):
        raise Refused(f"{top} is not a folder")
    tree = Tree()

    def walk(folder: bytes, under: bytes) -> None:
        with os.scandir(folder) as entries:
            for entry in entries:
                path = under + entry.name
                if left_out(path):
                    continue
                if entry.is_symlink():  # a link to a folder too: counted as a link, never followed
                    tree.link(path, os.readlink(entry.path))
                elif entry.is_dir(follow_symlinks=False):
                    walk(entry.path, path + b"/")
                elif entry.is_file(follow_symlinks=False):
                    with open(entry.path, "rb") as f:
                        tree.file(path, entry.stat(follow_symlinks=False).st_mode, f.read())
                else:
                    raise Refused(f"{os.fsdecode(path)} in {top} is not a file, a symbolic link or a folder")

    try:
        walk(os.fsencode(top), b"")
    except OSError as exc:
        raise Refused(f"cannot read {top}: {exc}") from exc
    return tree


class Member(tarfile.TarInfo):
    """A member of an archive, as tarfile reads it, which says on the archive when its end is read.

    tarfile stops at the block of zeros tar writes after the last member. It also stops, saying
    nothing, where a stream is cut short between two members and at a header it cannot read; the
    members after either would not be counted, and the code would name a tree the archive is not."""

    @classmethod
    def fromtarfile(cls, archive):
        try:
            return super().fromtarfile(archive)
        except tarfile.EOFHeaderError:  # the block of zeros
            archive.ended = True
            raise


def from_archive(stream) -> Tree:
    tree = Tree()
    try:
        # A stream is read once, front to back: each member's bytes as it comes. Names are taken as the bytes
        # the archive holds, as tar writes them on unpacking.
        with tarfile.open(fileobj=stream, mode="r|*", encoding="utf-8", errors="surrogateescape",
                          tarinfo=Member) as archive:
            for member in archive:
                path = member.name.encode("utf-8", "surrogateescape")
                if left_out(path) or member.isdir():
                    continue
                if member.issym():
                    tree.link(path, member.linkname.encode("utf-8", "surrogateescape"))
                elif member.isreg():
                    tree.file(path, member.mode, archive.extractfile(member).read())
                else:
                    raise Refused(f"{member.name} in the archive is not a file, a symbolic link or a folder")
            if not getattr(archive, "ended", False):
                raise Refused("standard input is not a whole tar archive: it stops before the archive's end, "
                              "or at a header that cannot be read")
    except (tarfile.TarError, OSError) as exc:
        raise Refused(f"standard input is not a tar archive that can be read: {exc}") from exc
    return tree


def release_number(tree: Tree, which: str) -> str:
    if tree.pyproject is None:
        raise Refused(f"{which} has no pyproject.toml")
    try:
        project = tomllib.loads(tree.pyproject.decode("utf-8")).get("project")
    except ValueError as exc:  # not UTF-8, or not TOML
        raise Refused(f"cannot read the pyproject.toml of {which}: {exc}") from exc
    number = project.get("version") if isinstance(project, dict) else None  # no [project], or not a table
    if number is None:
        raise Refused(f"the pyproject.toml of {which} names no version")
    if not isinstance(number, str):  # TOML's strings are in quotes: version = 0.2 is a number
        raise Refused(f'the release number of {which}, {number!r}, is not in quotes, as in version = "0.2.0"')
    if not NUMBER.fullmatch(number):
        raise Refused(f"the release number of {which}, {number!r}, is not three numbers with no leading zeros, "
                      "such as 0.2.0")
    return number


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="release-name", description=__doc__.split("\n\n")[0])
    parser.add_argument("folder", nargs="?", help="the tree to name")
    parser.add_argument("--archive", action="store_true", help="read the tree as a tar stream on standard input")
    parser.add_argument("--full", action="store_true", help="print the name, the number and the whole code")
    args = parser.parse_args(argv)
    if args.archive == (args.folder is not None):
        parser.error("give a folder, or --archive with a tar stream on standard input")
    try:
        if args.archive:
            tree, which = from_archive(sys.stdin.buffer), "the archive"
        else:
            tree, which = from_folder(args.folder), args.folder
        number = release_number(tree, which)
    except Refused as exc:
        print(f"release-name: {exc}", file=sys.stderr)
        return 1
    code = tree.code()
    name = f"{number}-{code[:12]}"
    print(f"{name} {number} {code}" if args.full else name)
    return 0


if __name__ == "__main__":
    sys.exit(main())
